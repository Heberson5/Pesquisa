{
  "name": "pesquisa-satisfacao",
  "version": "1.5.0",
  "private": true,
  "description": "Sistema de coleta de pesquisa de satisfação (NPS) multi-filial com modo quiosque para tablets",
  "main": "server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch server.js",
    "create-admin": "node --disable-warning=ExperimentalWarning scripts/create-admin.js",
    "seed:demo": "node --disable-warning=ExperimentalWarning scripts/seed-demo.js",
    "test": "node --disable-warning=ExperimentalWarning --test tests/*.test.js",
    "test:telas": "node --disable-warning=ExperimentalWarning scripts/check-responsive.js",
    "docs:prints": "node --disable-warning=ExperimentalWarning scripts/screenshots.js",
    "docs:manual": "node scripts/build-docs.js"
  },
  "dependencies": {
    "baileys": "7.0.0-rc14",
    "express": "^5.3.0",
    "nodemailer": "^10.1.2",
    "pptxgenjs": "^3.12.0",
    "qrcode": "^1.5.4"
  },
  "overrides": {
    "image-size": "^2.0.4"
  },
  "devDependencies": {
    "playwright": "1.56.1"
  }
}
