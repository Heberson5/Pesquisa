# Porta e interface. Em produção, deixe 127.0.0.1 e publique via proxy reverso com HTTPS (nginx/Caddy).
PORT=3000
HOST=127.0.0.1
NODE_ENV=production
# Cookies só via HTTPS (obrigatório em produção).
COOKIE_SECURE=true
# Número de proxies na frente do app (1 = nginx/Caddy). NÃO defina se o app estiver exposto direto,
# senão um atacante pode forjar o IP pelo cabeçalho X-Forwarded-For e driblar os limites de tentativas.
TRUST_PROXY=1
# Onde ficam o banco e as mídias (faça backup desta pasta).
DB_FILE=/var/lib/pesquisa/pesquisa.db
MEDIA_DIR=/var/lib/pesquisa/media
